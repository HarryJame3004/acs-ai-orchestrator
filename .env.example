# ==============================================================================
# ACS AI Orchestrator — Environment Configuration Template
# Copy this file to .env or export variables in your shell.
# DO NOT COMMIT REAL SECRETS OR TOKENS TO GIT.
# ==============================================================================

# 9Router / LLM Gateway Configuration
# Required for Planner and Reviewer LLM capabilities (or configure ~/.claude/settings.json)
NINE_ROUTER_API_KEY=your_9router_api_key_here
ROUTER_API_KEY=your_fallback_api_key_here

# Model Assignments (free-tier models on 9Router)
ACS_MODEL_PLANNER=free-coding
ACS_MODEL_REVIEWER=free-review
ACS_MODEL_TESTER=free-testing

# Orchestrator Network Configuration
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=20129

# Worker Binaries (Override if custom paths are desired)
# AGPAIR_BIN=/path/to/venv/bin/agpair
# CODEX_BIN=/usr/local/bin/codex
# AGY_A_BIN=/home/khoi/.local/bin/agy
# AGY_B_BIN=/home/khoi/.local/bin/agy-b

# CoreLock Protected Path (Read-Only safeguard)
# ACS_CORE_PATH=/home/khoi/autonomous-coding-system
